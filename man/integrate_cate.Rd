A <- rbinom(n, 1, e)
tau_x <- 1 + 0.5 * X$x1                 # true CATE
mu0 <- X$x1
mu1 <- mu0 + tau_x
Y <- mu0 + A * tau_x + rnorm(n, sd = 0.5)

